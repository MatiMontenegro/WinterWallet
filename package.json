{
  "name": "winterwallet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A real, non-custodial EVM Web3 wallet — installable as an iPhone PWA, deployed to Cloudflare Pages, with Postgres RLS for transaction history.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon.svg",
    "deploy": "wrangler pages deploy dist --project-name winterwallet"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.4",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "viem": "^2.23.2",
    "wagmi": "^2.14.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^3.108.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "keccak", "bufferutil", "utf-8-validate", "workerd"]
  }
}
