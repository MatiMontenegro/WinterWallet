# Copy to `.env.local` (gitignored) and fill in.
# Vite only exposes vars that begin with `VITE_` to the client bundle.
# These are PUBLIC values — anything that must stay secret belongs in a
# Cloudflare Pages secret or a Supabase Edge Function secret instead.

# --- Supabase --------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SIWE_VERIFY_URL=

# --- WalletConnect (RainbowKit needs this even for testing) ----------------
# Get one at https://cloud.reown.com/
VITE_WALLETCONNECT_PROJECT_ID=

# --- Default chain -------------------------------------------------------
# 11155111 = Sepolia testnet (recommended default)
# 1        = Ethereum mainnet
# 80002    = Polygon Amoy testnet
# 137      = Polygon mainnet
VITE_DEFAULT_CHAIN_ID=11155111

# --- Optional: custom RPCs (otherwise we fall back to public providers) ----
VITE_RPC_SEPOLIA=
VITE_RPC_MAINNET=
VITE_RPC_POLYGON_AMOY=
VITE_RPC_POLYGON=

# --- Monetization (commission-per-transfer model) -------------------------
# Address of your deployed FeeRouter contract (see contracts/FeeRouter.sol).
# When set, the Send flow routes transfers through the router and you collect
# a commission (configured in the contract itself, max 1%).
VITE_FEE_ROUTER_SEPOLIA=
VITE_FEE_ROUTER_MAINNET=
VITE_FEE_ROUTER_POLYGON_AMOY=
VITE_FEE_ROUTER_POLYGON=

# Fee disclosure shown in the UI (basis points; must equal what the contract enforces)
# Example: 30 = 0.30%
VITE_FEE_BPS=30

# Brand
VITE_APP_NAME=WinterWallet
VITE_APP_URL=https://winterwallet.pages.dev
